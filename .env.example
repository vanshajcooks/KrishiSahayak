# ==========================================
# SIH 26180 — Smart Farming Assistant
# Environment Configuration Template
# Copy this file to .env and adjust values
# ==========================================

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Database (SQLite)
# Local SQLite database file path
DATABASE_URL=sqlite:///./smart_farming.db

# CORS Configuration (Comma-separated origins for Next.js frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Weather API Configuration (Used by Decision Engine)
# Example: Open-Meteo requires no key, or provide API key if using provider like WeatherAPI/OpenWeatherMap
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Field Deployment (Raspberry Pi Edge Gateway)
# Default gateway IP on local field WiFi / Hotspot
EDGE_GATEWAY_HOST=192.168.4.1
EDGE_GATEWAY_PORT=8000

# ==========================================
# Authentication & Twilio Verify Configuration (Phase 3)
# ==========================================
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
AUTH_ACCESS_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax

# Twilio Verify Service Credentials
# DO NOT commit real keys to version control
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Development Provisioning Farmer Phone
# Used exclusively by dev_provision.py for local node testing
# DEV_FARMER_PHONE=+919876543210
